<Window
    x:Class="CamTouchUI.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:CamTouchUI"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 状态栏 -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Padding="12" Spacing="8">
            <TextBlock Text="相机:"/>
            <TextBlock x:Name="CameraStatusText" Text="未知"/>
            <TextBlock Text="帧率:" Margin="20,0,0,0"/>
            <TextBlock x:Name="FpsText" Text="0"/>
            <TextBlock Text="状态:" Margin="20,0,0,0"/>
            <TextBlock x:Name="StatusText" Text="未连接"/>
            <TextBlock Text="手数:" Margin="20,0,0,0"/>
            <TextBlock x:Name="HandsText" Text="0"/>
        </StackPanel>

        <!-- 主内容区：按钮 -->
        <StackPanel Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="12">
            <Button x:Name="StartButton" Content="开始触控" Click="StartButton_Click" Width="200" Height="40"/>
            <Button x:Name="StopButton" Content="暂停" Click="StopButton_Click" Width="200" Height="40"/>
            <Button x:Name="CalibrateButton" Content="进入校准" Click="CalibrateButton_Click" Width="200" Height="40"/>
            <Button x:Name="SettingsButton" Content="设置" Click="SettingsButton_Click" Width="200" Height="40"/>
        </StackPanel>

        <!-- 底部提示 -->
        <TextBlock Grid.Row="2" Text="系统托盘可快速控制" HorizontalAlignment="Center" Margin="0,0,0,10"/>
    </Grid>
</Window>
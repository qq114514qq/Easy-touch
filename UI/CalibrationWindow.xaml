<Window
    x:Class="CamTouchUI.CalibrationWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">
    <Grid Padding="40">
        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="12">
            <TextBlock Text="准备校准" FontSize="20" HorizontalAlignment="Center"/>
            <TextBlock Text="请点击“开始”后，用手指点击电视屏幕上的目标点。" TextWrapping="Wrap" HorizontalAlignment="Center"/>
            <Button Content="开始校准" Click="StartCalibration_Click" Width="150" Height="40"/>
            <Button Content="取消" Click="Cancel_Click" Width="150" Height="40"/>
        </StackPanel>
    </Grid>
</Window>